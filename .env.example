# MongoDB connection string. Must select the `portfolio` database
# (the OxiMod models are compiled against that name and the app refuses
# to start on a mismatch), e.g.:
#   mongodb+srv://user:pass@cluster.mongodb.net/portfolio?retryWrites=true&w=majority
DATABASE_URL=

# Secret used to sign the admin session JWT (HS256). At least 16 chars.
# Keep the value the previous deployment used so existing tokens verify.
JWT_SECRET=

# AWS credentials/region for S3 media uploads (read by the AWS SDK).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# S3 bucket receiving media uploads.
S3_BUCKET_NAME=

# Canonical public origin used for SEO output (canonical URLs, sitemap,
# feed, robots). Replaces the old HOST_NAME variable.
SITE_BASE_URL=https://arshiaeskandari.com

# reCAPTCHA v3 for the public contact form. Replaces
# NEXT_PUBLIC_ENABLE_RECAPTCHA (the old name is still honored as a
# fallback for ENABLE_RECAPTCHA). RECAPTCHA_SITE_KEY is rendered into the
# public page; RECAPTCHA_SECRET_KEY stays server-side.
ENABLE_RECAPTCHA=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=

# Server bind address (new; defaults shown).
APP_HOST=0.0.0.0
APP_PORT=3000

# Set to `production` to enable Secure cookies and HSTS.
APP_ENV=development

# Log filter, e.g. info | debug | portfolio=debug,tower_http=info
RUST_LOG=info
